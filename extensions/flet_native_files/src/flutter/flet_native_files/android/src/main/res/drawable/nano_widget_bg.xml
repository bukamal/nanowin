<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX_0.9.3: refined card background — deep Cashir-blue gradient for
  contrast with white KPI text, 20dp corners and a 1dp translucent white
  hairline stroke so the card separates cleanly from any wallpaper
  (RemoteViews cannot render elevation shadows, so the stroke does that
  job). Palette stays inside Cashir's theme (theme.py: PRIMARY #0B5FCC,
  PRIMARY_DARK #0A4CAB).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="135"
        android:endColor="#0A4CAB"
        android:startColor="#0B5FCC"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
</shape>
